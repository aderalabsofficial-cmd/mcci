# MCCI self-hosted Supabase — runtime environment TEMPLATE (variable names and non-secret defaults only).
#
# Never fill this file in place and never commit real values. scripts/selfhost/init-runtime.sh copies it to
# <runtime>/.env OUTSIDE the repo and fills every secret with upstream's generators, without printing anything
# (deploy/selfhost/README.md). Values marked "secret" stay empty here on purpose.

# ── Secrets: generated by upstream utils/generate-keys.sh ─────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# ── Secrets: generated by upstream utils/add-new-auth-keys.sh (publishable/secret keys, docs/17 §1 decision 2) ──
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
JWT_KEYS=
JWT_JWKS=

# ── Secrets: set by an operator when known (leave empty for the isolated test stack) ──────────────────────────────
SMTP_PASS=
OPENAI_API_KEY=

# ── Gateway and URLs (local isolated test defaults; staging values come with the VM / TLS proxy decision) ─────────
API_GW_HTTP_PORT=18000
KONG_HTTP_PORT=18000
SUPABASE_PUBLIC_URL=http://127.0.0.1:18000
API_EXTERNAL_URL=http://127.0.0.1:18000/auth/v1
SITE_URL=http://127.0.0.1:3000
ADDITIONAL_REDIRECT_URLS=
DASHBOARD_USERNAME=mcci-admin

# ── Database (reachable only on the Compose network; no host port is published) ──────────────────────────────────
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=mcci
POOLER_DB_POOL_SIZE=5

# ── API (the MCCI override fixes PGRST_DB_SCHEMAS=public,api; these keep upstream's interpolation satisfied) ──────
PGRST_DB_SCHEMAS=public,api
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

# ── Auth (security switches are fixed in docker-compose.mcci.yml; these are the business settings) ───────────────
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"
# TODO(MCCI): production SMTP provider + SPF/DKIM/DMARC (docs/17 §10). Placeholders keep Auth bootable without mail.
SMTP_ADMIN_EMAIL=admin@example.invalid
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USER=
SMTP_SENDER_NAME=MCCI
# MCCI email templates (docker-compose.mcci.yml): empty = Auth's built-in ones. With the app on its host, e.g.
# MAILER_TEMPLATES_CONFIRMATION=https://app.mcci.aderalabs.tech/email-templates/confirmation.html
MAILER_TEMPLATES_CONFIRMATION=
MAILER_TEMPLATES_MAGIC_LINK=
MAILER_TEMPLATES_RECOVERY=
MAILER_TEMPLATES_EMAIL_CHANGE=
MAILER_TEMPLATES_REAUTHENTICATION=

# ── Storage (file backend under the runtime data directory; FILE_SIZE_LIMIT is fixed in the override) ───────────
GLOBAL_S3_BUCKET=stub
STORAGE_TENANT_ID=stub
REGION=stub
IMGPROXY_AUTO_WEBP=true

# ── Studio ────────────────────────────────────────────────────────────────────────────────────────────────────────
STUDIO_DEFAULT_ORGANIZATION=MCCI
STUDIO_DEFAULT_PROJECT=MCCI Digital (isolated test)

# ── Edge Functions are not run (profile "functions"); kept only so upstream interpolation resolves ────────────────
FUNCTIONS_VERIFY_JWT=true
