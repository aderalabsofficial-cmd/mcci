# PROPOSED — NOT APPLIED. TLS reverse proxy for the self-hosted Supabase API of the MCCI staging stack
# (docs/17 §3, §10, D-M23; deploy/selfhost/README.md §9). Needs explicit approval before it is copied to
# /etc/nginx/conf.d/ on the VPS, together with the certificate step and the runtime .env change listed in README §9.
#
# Exposes ONLY the four client APIs of the gateway (127.0.0.1:18000, loopback-only). Everything else — Studio (/),
# postgres-meta (/pg/), /mcp, /api/mcp, Realtime admin (/realtime/v1/api/), /functions/v1/ (not run), /graphql/v1/
# (not used) — gets 404 here; admins reach Studio through an SSH tunnel only:
#   ssh -N -L 18000:127.0.0.1:18000 mcci-vps   then   http://127.0.0.1:18000/   (Studio basic auth)
# An IP allowlist for Studio is possible later (D-M23); it is deliberately not included.

map $http_upgrade $mcci_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name mcci.aderalabs.tech;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name mcci.aderalabs.tech;

    ssl_certificate     /etc/letsencrypt/live/mcci.aderalabs.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcci.aderalabs.tech/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:mcci_ssl:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    server_tokens off;

    # Storage accepts up to 10 MiB per file (docker-compose.mcci.yml FILE_SIZE_LIMIT); allow multipart overhead.
    client_max_body_size 11m;

    # Realtime admin endpoints: never through the proxy (the gateway also denies them, G6)
    location ^~ /realtime/v1/api/ {
        return 404;
    }

    location ~ ^/(rest|auth|storage|realtime)/v1/ {
        proxy_pass http://127.0.0.1:18000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # OVERWRITE, never append: Auth rate-limits per X-Real-IP (GOTRUE_RATE_LIMIT_HEADER, D-M22); a value a client
        # sends itself must not survive this proxy, or it could rotate it to evade the limits.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        # Realtime websockets
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $mcci_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Studio, /pg/, /mcp, /api/mcp, /functions/v1/, /graphql/v1/ and anything else
    location / {
        return 404;
    }
}
