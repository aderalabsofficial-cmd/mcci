# /etc/mcci-web/env — runtime settings of the MCCI app on the VPS (docs/20-deployment-plan.md §3).
# Owner: root, mode 0600. Filled in ON THE SERVER by the owner; never committed, never pasted into chat or tickets.
# Names and meaning: .env.example. Values below are the non-secret ones for app.mcci.aderalabs.tech.

# Browser + server: the public host carries both the app and the Supabase API (nginx routes /rest|auth|storage|realtime)
NEXT_PUBLIC_SUPABASE_URL=https://app.mcci.aderalabs.tech
# sb_publishable_… from the stack's runtime .env (public by design)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_… from the stack's runtime .env (SECRET — server only)
SUPABASE_SECRET_KEY=
# the server talks to the gateway on loopback, not through the internet
SUPABASE_INTERNAL_URL=http://127.0.0.1:18000

# the app listens on 127.0.0.1 only and nginx overwrites X-Real-IP, so the header can be trusted
TRUST_PROXY_CLIENT_IP=1
CLIENT_IP_HEADER=x-real-ip

APP_URL=https://app.mcci.aderalabs.tech
VERIFY_BASE_URL=https://app.mcci.aderalabs.tech/verify

# App-sent email (invitations). Same relay as Auth's SMTP settings in the stack's runtime .env: Resend
# (smtp.resend.com, user "resend", password = a Resend API key, port 465 + SMTP_SECURE=1), sending as
# no-reply-mcci@aderalabs.tech with replies to the MCCI mailbox. Never the cPanel relay (MailChannels blocks it).
EMAIL_TRANSPORT=smtp
EMAIL_FROM=no-reply-mcci@aderalabs.tech
EMAIL_FROM_NAME=MCCI
EMAIL_REPLY_TO=mcci@aderalabs.tech
SMTP_HOST=
SMTP_PORT=587
# 1 only for implicit TLS (port 465); STARTTLS on 587 is enforced otherwise
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# AI document reading (docs/08) stays off until the owner approves (D-M13): AI_EXTRACTION=on AND a key. Server only.
AI_EXTRACTION=off
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACT=
