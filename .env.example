# Copy to .env.local and fill in. Never commit real values (CLAUDE.md §1.10).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only
OPENAI_API_KEY=                     # server only
OPENAI_MODEL_EXTRACT=gpt-4.1-mini
EMAIL_FROM="MCCI <no-reply@mcci.org.pk>"
EMAIL_PROVIDER=smtp                 # smtp | resend
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
CRON_SECRET=                        # shared with pg_cron http calls
APP_URL=http://localhost:3000
VERIFY_BASE_URL=https://mcci.org.pk/verify   # printed in QR codes
# Android app (docs/15-mobile-app.md §6)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=           # server only
ANDROID_CERT_SHA256=                # comma-separated
