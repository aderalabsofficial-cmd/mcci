# Copy to .env.local and fill in. Never commit real values (CLAUDE.md §1.10).
# Local values: `pnpm exec supabase status -o env` (API_URL, PUBLISHABLE_KEY, SECRET_KEY, MAILPIT_URL).

# Supabase — publishable key in the browser, secret key on the server only (docs/17 §11)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional: where the SERVER reaches Supabase when it differs from the public URL (e.g. http://127.0.0.1:18000)
SUPABASE_INTERNAL_URL=

# Client address for Auth rate limits (lib/net/client-ip.ts). Set TRUST_PROXY_CLIENT_IP=1 ONLY when the app is
# reachable solely through a proxy that overwrites the header (nginx: proxy_set_header X-Real-IP $remote_addr).
TRUST_PROXY_CLIENT_IP=
CLIENT_IP_HEADER=x-real-ip

# App-sent email (lib/email/send.ts). Auth's own emails use Supabase Auth's SMTP settings.
EMAIL_TRANSPORT=smtp
EMAIL_FROM=mcci@aderalabs.tech
EMAIL_FROM_NAME=MCCI
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Local development only (EMAIL_TRANSPORT=mailpit): the Supabase CLI mail catcher
MAILPIT_URL=

# Public URL of this app (links in emails, Auth redirects)
APP_URL=
VERIFY_BASE_URL=

# AI (server only; docs/08). Off until MCCI approves consent terms (D-M13).
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACT=

CRON_SECRET=
# Android app (docs/15-mobile-app.md §6)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
ANDROID_CERT_SHA256=
